# Source: https://github.com/phonegap/phonegap-app-developer/blob/master/.gitignore

# Mac
.DS_Store

# Node
npm-debug.log
/node_modules

# Cordova
/platforms
/plugins

# res
resources/signing

# vscode project settings
.vscode/

# the npm lock file introduced issues when upgrading to the latest version of cordova
package-lock.json 

# iOS: save build assets
!platforms/ios/Pedi Crisis/Images.xcassets/AppIcon.appiconset/
!platforms/ios/Pedi Crisis/Images.xcassets/AppIcon.appiconset/*
!platforms/ios/Pedi Crisis/Images.xcassets/LaunchStoryboard.imageset

# iOS: Do not allow WKWebView to adjust the height of the body; adds the following:
# wkWebView.scrollView setContentInsetAdjustmentBehavior:UIScrollViewContentInsetAdjustmentNever];
# See: https://github.com/apache/cordova-ios/issues/933#issuecomment-722241225
!/platforms/ios/CordovaLib/Classes/Private/Plugins/CDVWebViewEngine/CDVWebViewEngine.m

# This is useful for reproducible builds
!/platforms/ios/Pedi Crisis/Pedi Crisis-Info.plist

# The Cordova launch screen never really works. Use this instead.
!/platforms/ios/LaunchScreen.storyboard